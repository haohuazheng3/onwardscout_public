{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/jobs",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sources",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/followups",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/expire",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 14 * * 1"
    }
  ]
}
