# Copy to .env.local and fill in. Never commit real values.
# Required variables are checked by /api/health (it answers 503 until every one is set).

# ---------------------------------------------------------------- site
# Canonical origin of this deployment (no trailing slash). Previews fall back to VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 only on the production deployment after launch; everything else stays noindex.
SITE_INDEXABLE=0
# Admin sign-ins: verified email addresses, comma-separated.
ADMIN_EMAILS=

# ---------------------------------------------------------------- database (Neon / any Postgres)
# Pooled connection for the app; direct (unpooled) connection for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------- accounts (Clerk, email code only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# ---------------------------------------------------------------- payments (Stripe)
# STRIPE_SECRET_KEY may be an account key or an organization key; STRIPE_CONTEXT names the
# account to act on (acct_…), sent as the Stripe-Context header.
STRIPE_SECRET_KEY=
STRIPE_CONTEXT=
STRIPE_WEBHOOK_SECRET=
# Price ids: Pro monthly plan and the one-time credit packs.
STRIPE_PRICE_PRO=
STRIPE_PRICE_PACK_10=
STRIPE_PRICE_PACK_40=
# Optional: billing portal configuration id; the default portal when empty.
STRIPE_PORTAL_CONFIG=
# Optional, supervised tests only: lets a non-production deployment open a live Checkout.
ALLOW_LIVE_CHECKOUT_NONPROD=
# 1 opens live sales. Set it only once STRIPE_CONTEXT is Onward Scout's own Stripe account (the
# merchant name on receipts and card statements must be Onward Scout); until then live
# checkout answers "Purchases open soon".
PAYMENTS_OPEN=
# Optional: the Stripe account's statement-descriptor prefix (shortened descriptor). Unknown →
# the suffix is trimmed so "<prefix>* <suffix>" fits 22 characters for any prefix.
STRIPE_STATEMENT_PREFIX=

# ---------------------------------------------------------------- private files (Cloudflare files worker in front of R2)
FILES_BASE_URL=
FILES_SIGNING_SECRET=
FILES_API_TOKEN=

# ---------------------------------------------------------------- mail
# Mail worker: owner alerts (POST /notify) and the inbound inbox (test@, reply drop-boxes).
MAIL_WORKER_URL=
MAIL_WORKER_TOKEN=
INBOX_INGEST_SECRET=
INBOX_READ_TOKEN=
# Optional: product email to users (weekly digest, "needs you") through Resend.
# Without both, users get in-app notifications only.
RESEND_API_KEY=
MAIL_FROM=

# ---------------------------------------------------------------- integrations
# 64 hex characters (32 bytes): encrypts stored OAuth refresh tokens (AES-256-GCM).
INTEGRATION_KEY=
# Optional: Gmail outreach (scope gmail.send only). Both or neither.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------- intelligence
# anthropic | local | mock. Unset: anthropic when ANTHROPIC_API_KEY is set, else local
# (the deterministic engine). mock is for tests and is refused on production.
LLM_PROVIDER=
# Runtime only: never used by scripts, tests or builds.
ANTHROPIC_API_KEY=
# Per-user monthly model budget in US cents; over budget the local engine takes over.
LLM_USER_MONTHLY_CENTS=300
# Signed-out drafts (/app/start): model budget per draft, and per UTC day for all drafts together.
LLM_ANON_DRAFT_CENTS=30
LLM_ANON_DAILY_CENTS=500
# 1 lets the browser agent (CH3) fill web forms; otherwise those go to the handoff panel.
BROWSER_AGENT_ENABLED=0
# Optional (set by Vercel when "Protection Bypass for Automation" is on): lets a protected preview
# deployment reach its own practice sandbox server-side.
VERCEL_AUTOMATION_BYPASS_SECRET=

# ---------------------------------------------------------------- opportunity sources
# Optional: newest postings kept per ATS board (default 200).
SOURCES_MAX_JOBS_PER_BOARD=
# Optional: above this database size (MB) the source runs only update, never insert (default 420).
SOURCES_DB_SIZE_LIMIT_MB=

# ---------------------------------------------------------------- operations
# Bearer secret for /api/cron/* (Vercel Cron sends it automatically) and detailed /api/health.
CRON_SECRET=
# Public IndexNow key (also served at /indexnow.txt).
INDEXNOW_KEY=
# Optional deploy fallback: the GitHub webhook (workflow_run) signs calls to /api/hooks/github
# with this secret; when the Deploy workflow fails, the route POSTs the Vercel Deploy Hook.
GITHUB_WEBHOOK_SECRET=
VERCEL_DEPLOY_HOOK_URL=

# ---------------------------------------------------------------- analytics (FlowGlance)
NEXT_PUBLIC_FLOWGLANCE_KEY=
FLOWGLANCE_SITE_ID=
